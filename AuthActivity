class AuthActivity : AppCompatActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()
        setContentView(R.layout.activity_auth)

        val userName: EditText = findViewById(R.id.tvName)
        val userPhone: EditText = findViewById(R.id.tvPhone)
        val button: Button = findViewById(R.id.btnAuth)
        val database = FirebaseDatabase.getInstance().getReference("User")

        button.setOnClickListener {
            val name = userName.text.toString().trim()
            val phone = userPhone.text.toString().trim()

            if (name.isEmpty() || phone.isEmpty()) {
                Toast.makeText(this, "Не все поля заполнены", Toast.LENGTH_SHORT).show()
                return@setOnClickListener
            }

            // Ищем пользователя по номеру телефона
            database.orderByChild("phone").equalTo(phone).get().addOnSuccessListener { snapshot ->
                if (snapshot.exists()) {
                    var userFound = false
                    
                    // Так как поиск возвращает список (даже из 1 элемента), перебираем его
                    for (childSnapshot in snapshot.children) {
                        val user = childSnapshot.getValue(UserModel::class.java)
                        
                        // Проверяем, совпадает ли имя
                        if (user?.name == name) {
                            userFound = true
                            val userId = user.id // Получаем его реальный ID из базы

                            // Сохраняем состояние сессии локально
                            val sharePref = getSharedPreferences("UserPref", MODE_PRIVATE)
                            sharePref.edit().apply {
                                putBoolean("isLoggedIn", true)
                                putString("USER_ID", userId)
                                putString("USER_PHONE", phone)
                                apply()
                            }

                            val intent = Intent(this, ProfileActivity::class.java).apply {
                                putExtra("USER_ID", userId)
                            }
                            startActivity(intent)
                            finish()
                            break
                        }
                    }
                    if (!userFound) {
                        Toast.makeText(this, "Имя или телефон не совпадают", Toast.LENGTH_SHORT).show()
                    }
                } else {
                    Toast.makeText(this, "Неизвестный пользователь", Toast.LENGTH_SHORT).show()
                }
            }.addOnFailureListener {
                Toast.makeText(this, "Ошибка сети", Toast.LENGTH_SHORT).show()
            }
        }
    }
}
