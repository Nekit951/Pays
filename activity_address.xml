<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddressActivity">

    <RelativeLayout
        android:id="@+id/add_address_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:paddingVertical="16dp">

        <ImageView
            android:id="@+id/addAddressView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/darkgrey_half_corner"
            android:layout_marginTop="10dp"
            android:layout_marginStart="30dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Добавить адрес"
            android:textSize="18dp"
            android:textColor="@color/black"
            android:layout_marginTop="18dp"
            android:layout_marginStart="120dp"/>

    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewAddress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/add_address_container"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="16dp"
        tools:listitem="@layout/viewholder_address" />

</RelativeLayout>